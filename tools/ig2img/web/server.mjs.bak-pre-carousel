// ---------------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------------
const MAX_QUEUED = 30;
const MAX_LOG_LINES = 2000;
const jobs = new Map();          // id -> job (newest last)
const queue = [];                // jobs waiting to run, in order
let current = null;              // the job running right now
const sse = new Set();

const clampInt = (v, lo, hi, d) => Math.min(hi, Math.max(lo, Number.isFinite(Number(v)) ? Math.trunc(Number(v)) : d));

function summary(j) {
  return {
    id: j.id, mode: j.mode, source: j.source, instruction: j.instruction, count: j.count,
    status: j.status, message: j.message, step: j.step,
    createdAt: j.createdAt, startedAt: j.startedAt, finishedAt: j.finishedAt,
    runId: j.runId, runKind: j.mode === 'design' ? 'design' : 'run', imageCount: j.imageCount, error: j.error,
    origin: j.origin || 'web', kind: j.kind || 'reference', description: j.description || '', productUrl: j.productUrl || '',
    canvaUrl: j.canvaUrl || null, finalUrl: j.finalUrl || null, rating: j.rating || null, aiMethod: j.aiMethod || null, position: queue.indexOf(j) + 1 || null,
    stopping: !!j.stopRequested, stoppable: !!j.child,
  };
}

// ---------------------------------------------------------------------------------
// The project tracker: one row per job — where it came from, what it is, its status (kept current by the
// pipeline's own progress lines) and the final Canva link. Saved to disk so it survives a restart.
// ---------------------------------------------------------------------------------
const tracker = new Map();       // id -> record (newest last)
let trackerTimer = null;
function trackerRecord(j) {
  return { ...summary(j), input: j.input || null, attempts: j.attempts || 0, chatId: j.chatId || null, logTail: (j.log || []).slice(-25) };
}
function saveTracker() {
  try {
    mkdirSync(DATA_DIR, { recursive: true });
    const rows = [...tracker.values()].slice(-500);
    writeFileSync(TRACKER_FILE, JSON.stringify({ savedAt: Date.now(), rows }, null, 1));
  } catch (e) { wlog(`TRACKER save failed: ${e.message}`); }
}
const summaryOf = ({ input, logTail, chatId, attempts, ...r }) => r;
function track(j) {
  tracker.set(j.id, trackerRecord(j));
  clearTimeout(trackerTimer);
  trackerTimer = setTimeout(saveTracker, 500);
}
function emit(event, data) {
  const payload = `event: ${event}\ndata: ${JSON.stringify(data)}\n\n`;
  for (const res of sse) { try { res.write(payload); } catch { sse.delete(res); } }
}
function touch(job, patch = {}) { Object.assign(job, patch); track(job); emit('job', summary(job)); }

function pushLine(job, line) {
  job.log.push(line);
  if (job.log.length > MAX_LOG_LINES) job.log.splice(0, job.log.length - MAX_LOG_LINES);
  wlog(`${job.id.slice(0, 8)} ${line}`);
  emit('log', { id: job.id, line });

  // Progress: the pipeline announces its stages as "[1/4]" … "[4/4]" ("[1-2/4]" for the
  // idea/promote modes, which skip the Instagram read); the design job uses "[1/5]" … "[5/5]".
  let step = job.step;
  const d5 = line.match(/\[(\d)\/5\]/);
  if (d5) step = Number(d5[1]);
  else if (/\[4\/4\]/.test(line)) step = 4;
  else if (/\[3\/4\]/.test(line)) step = 3;
  else if (/\[2\/4\]|\[1-2\/4\]/.test(line)) step = 2;
  else if (/\[1\/4\]/.test(line)) step = 1;
  // Headline = the latest unindented line (the pipeline's own "say" messages + stage titles).
  const headline = /^\S/.test(line) ? line.trim() : null;
  if (step !== job.step || (headline && headline !== job.message)) {
    touch(job, { step, ...(headline ? { message: headline } : {}) });
  }
}

/** Jobs that came in on Telegram are answered there: the final picture and the Canva link. */
async function notifyOrigin(job) {
  if (job.origin !== 'telegram' || !job.chatId || job.status !== 'done') return;
  const tg = await import('../lib/telegram.mjs');
  const abs = job.runId ? join(DESIGN_DIR, job.runId, 'FINAL.png') : '';
  const cap = `${job.description || 'Your design'}\n${job.canvaUrl ? `Edit in Canva: ${job.canvaUrl}` : 'Canva link not available.'}`;
  if (abs && existsSync(abs)) await tg.sendImage(abs, cap.slice(0, 1000), job.chatId);
  else await tg.sendText(cap, job.chatId);
}

function trimFinished() {
  const finished = [...jobs.values()].filter((j) => ['done', 'failed', 'cancelled', 'stopped'].includes(j.status));
  for (const j of finished.slice(0, Math.max(0, finished.length - 20))) jobs.delete(j.id);
}

// Same pattern + canonical form as normaliseIgUrl() in lib/ig.mjs, so a pasted
// "create https://…/p/X/?utm_source=…" and the clean link are recognised as the same post.
const IG_RE = /instagram\.com\/(?:[A-Za-z0-9_.]+\/)?(p|reel|reels|tv)\/([A-Za-z0-9_-]+)/i;

const REF_LINK_OK = (s) => IG_RE.test(s) || /pinterest\.[a-z.]+\/pin\/|pin\.it\//i.test(s) || /^https?:\/\/\S+\.(?:png|jpe?g|webp)(?:\?\S*)?$/i.test(s);
const KAPRUKA_URL_RE = /^https?:\/\/(?:www\.)?kapruka\.com\//i;
const short = (s, n = 60) => (String(s).length > n ? `${String(s).slice(0, n - 1)}…` : String(s));

/**
 * One job per reference (human rule 2026-11-22: "number of references = number of images to create"). The Design,
 * Persona promotion and Promote tabs all accept references (up to 3: links or uploaded images) and an optional
 * Kapruka product or category link; with no reference, persona/promote jobs go to the strategist.
 */
function buildJobs(b) {
  if (!b || typeof b !== 'object') return { error: 'Bad request.' };
  const tab = b.mode === 'recreate' ? 'design' : b.mode;
  if (!['design', 'idea', 'promote'].includes(tab)) return { error: 'Pick what you want to do first.' };
  const kind = tab === 'design' ? 'reference' : tab === 'idea' ? 'persona' : 'promote';
  const text = String(b.source ?? '').trim();
  const instruction = String(b.instruction ?? '').trim();
  if (instruction.length > 500) return { error: 'The creative note is too long (500 characters max).' };
  const productUrl = String(b.productUrl ?? '').trim();
  if (productUrl && !KAPRUKA_URL_RE.test(productUrl)) return { error: 'The product or category link must be a kapruka.com page.' };
  const relation = ['direct', 'indirect'].includes(b.relation) ? b.relation : 'auto';

  const refs = [];
  if (kind === 'reference' && text) refs.push({ type: 'link', value: text });
  for (const l of Array.isArray(b.refLinks) ? b.refLinks : []) { const v = String(l ?? '').trim(); if (v) refs.push({ type: 'link', value: v }); }
  const uploads = Array.isArray(b.uploads) ? b.uploads : [];
  if (refs.length + uploads.length > 3) return { error: 'Up to 3 references at a time (links and uploads together).' };
  for (const r of refs) {
    if (!REF_LINK_OK(r.value)) return { error: 'A reference link must be an Instagram post, a Pinterest pin or a direct image link.' };
    if (IG_RE.test(r.value)) {
      const ig = r.value.match(IG_RE); const k = ig[1].toLowerCase() === 'reels' ? 'reel' : ig[1].toLowerCase();
      r.value = `https://www.instagram.com/${k}/${ig[2]}/`;
    }
  }
  const stamp = Date.now(); let dir = null;
  for (const [i, u] of uploads.entries()) {
    const ext = extname(String(u?.name || '')).toLowerCase();
    if (!['.jpg', '.jpeg', '.png', '.webp'].includes(ext) || typeof u.b64 !== 'string' || !u.b64) return { error: 'An uploaded reference must be a JPG, PNG or WebP image.' };
    if (u.b64.length > 14 * 1024 * 1024) return { error: 'An uploaded image is too large (10 MB max).' };
    dir ||= join(INBOX_DIR, `web-${stamp}`);
    mkdirSync(dir, { recursive: true });
    const file = join(dir, `ref-${i + 1}${ext}`);
    writeFileSync(file, Buffer.from(u.b64, 'base64'));
    refs.push({ type: 'file', value: file, name: String(u.name).slice(0, 80) });
  }
  if (kind === 'reference' && !refs.length) return { error: 'Give a reference: paste an Instagram or Pinterest link, or upload an image.' };
  if (kind !== 'reference') {
    if (text.length < 2) return { error: kind === 'persona' ? 'Name the persona you want to promote to.' : 'Say what you want to promote.' };
    if (text.length > 300) return { error: 'That\'s too long (300 characters max).' };
  }
  const label = { reference: 'Design', persona: 'Persona promotion', promote: 'Promote' }[kind];
  const mk = (ref, i, n) => {
    const part = n > 1 ? ` (${i + 1} of ${n})` : '';
    const refLabel = ref ? (ref.type === 'file' ? ref.name : short(ref.value.replace(/^https?:\/\/(www\.)?/, ''), 48)) : '';
    const description = kind === 'reference'
      ? `Recreate ${refLabel}${productUrl ? ` for ${short(productUrl.replace(/^https?:\/\/(www\.)?kapruka\.com\//, ''), 40)}` : ''}${part}`
      : `${label}: ${short(text, 70)}${ref ? ` · ref ${refLabel}` : ''}${part}`;
    return {
      mode: 'design', kind, origin: 'web', ref: ref || null, source: ref ? (ref.type === 'file' ? ref.name : ref.value) : text,
      text: kind === 'reference' ? '' : text, productUrl, relation, count: 1, description,
      instruction: instruction + (!ref && n > 1 ? `${instruction ? ' ' : ''}(Idea ${i + 1} of ${n}: choose a different angle from the other ideas.)` : '').slice(0, 500),
    };
  };
  if (refs.length) return { specs: refs.map((r, i) => mk(r, i, refs.length)) };
  const n = clampInt(b.count, 1, 4, 1);
  return { specs: Array.from({ length: n }, (_, i) => mk(null, i, n)) };
}

function validate(b) {
  if (!b || typeof b !== 'object') return { error: 'Bad request.' };
  // "Canva for all links" (2026-11-15): an Instagram link always becomes a Canva design.
  const mode = b.mode === 'recreate' ? 'design' : b.mode;
  if (!['recreate', 'idea', 'promote', 'design'].includes(mode)) return { error: 'Pick what you want to do first.' };
  let source = String(b.source ?? '').trim();
  const instruction = String(b.instruction ?? '').trim();
  const count = clampInt(b.count, 1, 4, 1);
  if (instruction.length > 500) return { error: 'The creative note is too long (500 characters max).' };
  if (mode === 'recreate' || mode === 'design') {
    const ig = source.match(IG_RE);
    if (!ig) return { error: 'That doesn\'t look like an Instagram post or reel link (instagram.com/p/…, /reel/…).' };
    const kind = ig[1].toLowerCase() === 'reels' ? 'reel' : ig[1].toLowerCase();
    source = `https://www.instagram.com/${kind}/${ig[2]}/`;
  } else if (mode === 'idea') {
    if (source.length < 2) return { error: 'Name the persona you want ideas for.' };
    if (source.length > 200) return { error: 'Persona is too long (200 characters max).' };
  } else {
    if (source.length < 2) return { error: 'Say what you want to promote.' };
    if (source.length > 300) return { error: 'That\'s too long (300 characters max).' };
  }
  return { mode, source, instruction, count };
}

function createJob(v) {
  const dup = [...jobs.values()].find((j) =>
    ['queued', 'waiting', 'running'].includes(j.status) && j.mode === v.mode && j.source === v.source && (j.kind || 'reference') === (v.kind || 'reference') && (j.productUrl || '') === (v.productUrl || '') && (j.instruction || '') === (v.instruction || ''));
  if (dup) return { error: 'That exact job is already queued or running.', status: 409 };
  if (queue.length >= MAX_QUEUED) return { error: `The queue is full (${MAX_QUEUED}). Let some finish first.`, status: 429 };
  const job = {
    id: randomUUID(), ...v, status: 'queued', message: 'Waiting in the queue…', step: 0,
    createdAt: Date.now(), startedAt: null, finishedAt: null, runId: null, imageCount: null, error: null, log: [],
  };
  jobs.set(job.id, job);
  queue.push(job);
  job.input = jobInput(job);
  wlog(`${job.id.slice(0, 8)} QUEUED [${job.origin || 'web'}/${job.kind || job.mode}] ${job.description || job.source}${job.instruction ? ` — "${job.instruction}"` : ''}`);
  track(job);
  emit('job', summary(job));
  pump();
  return { job };
}

/** Everything the job process needs — kept on the job so a restart can run it again. */
const jobInput = (j) => ({
  mode: j.mode, kind: j.kind || 'reference', source: j.source, count: j.count, instruction: j.instruction || '',
  ref: j.ref || null, text: j.text || '', productUrl: j.productUrl || '', relation: j.relation || 'auto',
  refFiles: j.refFiles || [], caption: j.caption || '', tag: j.tag || '', aiMethod: j.aiMethod || '',
});

/** After a finished design job: the best design's Canva link and final picture for the tracker. */
function designOutcome(runId) {
  try {
    const j = readJsonFile(join(DESIGN_DIR, runId, 'design.json'));
    const vs = j?.variants || [];
    const v = vs[Number.isInteger(j?.best) ? j.best : 0] || vs.find((x) => x.canva) || null;
    return { canvaUrl: v?.canva?.editUrl || null, finalUrl: v ? dFileUrl(runId, 'FINAL.png') || dFileUrl(runId, v.final) || dFileUrl(runId, v.preview) : null };
  } catch { return { canvaUrl: null, finalUrl: null }; }
}

async function runJob(job) {
  current = job;
  job.attempts = (job.attempts || 0) + 1;
  const thinker = await import('../lib/thinker.mjs');
  job.aiMethod = thinker.aiMethod();                         // fixed for the whole job: it never switches method half-way
  touch(job, { status: 'running', startedAt: Date.now(), message: 'Starting…', step: 0 });
  const log = (...a) => {
    for (const raw of a.join(' ').split(/\r?\n/)) {
      const line = raw.replace(/\s+$/, '');
      if (line.trim()) pushLine(job, line);
    }
  };
  try {
    let res;
    if (job.aiMethod === 'cli' && !DEMO) {
      const cs = await thinker.cliStatus();
      if (!cs.installed) throw new Error('The AI method is CLI, but the Claude CLI is not installed on this PC (install it, or switch to Non-CLI in the header).');
      if (!cs.loggedIn) throw new Error('The AI method is CLI, but the Claude CLI is signed out. Run "claude auth login" in a terminal, or switch to Non-CLI in the header.');
    }
    if (DEMO) {
      const runPipeline = await getRunPipeline();
      const r = await runPipeline(job.source, { log });
      res = { outDir: r.outDir, count: r.images.length };
    } else {
      // Each job runs in its OWN process (job-runner.mjs) so "Stop" can end it — and the
      // Claude agents it spawned — without touching the server, Chrome or other jobs.
      res = await new Promise((resolveJob, rejectJob) => {
        const child = fork(join(HERE, 'job-runner.mjs'), [], { cwd: ROOT, stdio: ['ignore', 'pipe', 'pipe', 'ipc'], windowsHide: true });
        job.child = child;
        let result = null; let failure = null;
        child.stdout.on('data', (d) => log(String(d)));          // stray console output from libraries
        child.stderr.on('data', (d) => log(String(d)));
        child.on('message', (m) => {
          if (m.type === 'log') log(m.text);
          else if (m.type === 'done') result = m;
          else if (m.type === 'error') failure = m;
        });
        child.on('error', rejectJob);
        child.on('exit', (code) => {
          job.child = null;
          // Give the last IPC message ('done' / 'error') a moment to arrive: it can lose the race
          // with the exit event, and the real cause was then reported as "exited unexpectedly".
          setTimeout(() => {
            if (job.stopRequested) return rejectJob(Object.assign(new Error('Stopped by you'), { stopped: true, outDir: failure?.outDir }));
            if (result) return resolveJob(result);
            rejectJob(Object.assign(new Error(failure?.message || `the job process exited unexpectedly (code ${code})`), { outDir: failure?.outDir }));
          }, 500);
        });
        child.send(jobInput(job));
      });
    }
    const design = job.mode === 'design';
    const n = res.count ?? 0;
    const outcome = design ? designOutcome(basename(res.outDir)) : {};
    touch(job, {
      status: 'done', runId: basename(res.outDir), imageCount: n, step: design ? 5 : 4,
      message: design ? `Done — ${n} design${n === 1 ? '' : 's'} in Canva` : `Done — ${n} image${n === 1 ? '' : 's'}`, ...outcome,
    });
    notifyOrigin(job).catch((e) => wlog(`${job.id.slice(0, 8)} notify failed: ${e.message}`));
  } catch (e) {
    if (e.stopped) {
      wlog(`${job.id.slice(0, 8)} STOPPED by user`);
      touch(job, { status: 'stopped', message: 'Stopped by you', ...(e.outDir ? { runId: basename(e.outDir) } : {}) });
      return;
    }
    wlog(`${job.id.slice(0, 8)} FAILED ${e.message}`);
    touch(job, { status: 'failed', error: e.message, message: e.message, ...(e.outDir ? { runId: basename(e.outDir) } : {}) });
  } finally {
    job.finishedAt = Date.now();
    current = null;
    track(job);
    emit('job', summary(job));
    trimFinished();
  }
}

let pumping = false;
async function pump() {
  if (pumping) return;
  pumping = true;
  try {
    for (;;) {
      const job = queue[0];
      if (!job) break;
      // Chrome can only serve one pipeline run at a time. If the Telegram bot is mid-job,
      // hold this one back instead of colliding with it.
      while (queue[0] === job && botState().state === 'working') {
        if (job.status !== 'waiting') touch(job, { status: 'waiting', message: 'The Telegram bot is running a job — waiting for Chrome to be free…' });
        await sleep(8000);
      }
      if (queue[0] !== job) continue;          // cancelled while waiting
      queue.shift();
      await runJob(job);
    }
  } finally { pumping = false; }
}

function cancelJob(id) {
  const job = jobs.get(id);
  if (!job) return { error: 'No such job.', status: 404 };
  if (job.status === 'running') {
    if (!job.child) return { error: 'This job can\'t be stopped (it isn\'t running in its own process).', status: 409 };
    if (job.stopRequested) return { job };
    job.stopRequested = true;
    touch(job, { message: 'Stopping…' });
    // Kill the job process AND everything it started (Claude agents, Python helpers).
    // Chrome is not its child — it only attaches over CDP — so Chrome stays up.
    if (process.platform === 'win32') execFile('taskkill', ['/PID', String(job.child.pid), '/T', '/F'], () => {});
    else job.child.kill('SIGKILL');
    return { job };
  }
  const i = queue.indexOf(job);
  if (i === -1) return { error: 'That job has already finished.', status: 409 };
  queue.splice(i, 1);
  touch(job, { status: 'cancelled', message: 'Cancelled', finishedAt: Date.now() });
  return { job };
}

