// HTTP
// ---------------------------------------------------------------------------------
const TYPES = {
  '.html': 'text/html; charset=utf-8', '.css': 'text/css; charset=utf-8', '.js': 'text/javascript; charset=utf-8',
  '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.webp': 'image/webp', '.gif': 'image/gif',
  '.md': 'text/plain; charset=utf-8', '.txt': 'text/plain; charset=utf-8', '.svg': 'image/svg+xml',
};
const FILE_EXTS = new Set(['.png', '.jpg', '.jpeg', '.webp', '.gif', '.md', '.txt']);
const STATIC = new Set(['index.html', 'app.css', 'app.js', 'favicon.svg']);
const CSP = "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; "
  + "base-uri 'none'; form-action 'none'; frame-ancestors 'none'";

const originOk = (req) => {
  const o = req.headers.origin;
  if (!o) return true;
  try { return ALLOWED_HOSTS.has(new URL(o).host); } catch { return false; }
};

function json(res, code, obj) {
  const body = JSON.stringify(obj);
  res.writeHead(code, {
    'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store',
    'X-Content-Type-Options': 'nosniff',
  });
  res.end(body);
}

function readJson(req, limit = 16 * 1024) {
  return new Promise((resolveBody, reject) => {
    let size = 0; const chunks = [];
    req.on('data', (c) => {
      size += c.length;
      if (size > limit) { reject(Object.assign(new Error('Request too large.'), { status: 413 })); req.destroy(); return; }
      chunks.push(c);
    });
    req.on('end', () => {
      try { resolveBody(JSON.parse(Buffer.concat(chunks).toString('utf8') || '{}')); }
      catch { reject(Object.assign(new Error('Bad JSON.'), { status: 400 })); }
    });
    req.on('error', reject);
  });
}

function serveFile(req, res, abs, { download = false, cacheable = false } = {}) {
  let st;
  try { st = statSync(abs); } catch { return json(res, 404, { error: 'Not found.' }); }
  if (!st.isFile()) return json(res, 404, { error: 'Not found.' });
  const ext = extname(abs).toLowerCase();
  const headers = {
    'Content-Type': TYPES[ext] || 'application/octet-stream',
    'Content-Length': st.size,
    'X-Content-Type-Options': 'nosniff',
    'Cache-Control': cacheable ? 'public, max-age=31536000, immutable' : 'no-cache',
  };
  if (ext === '.html') headers['Content-Security-Policy'] = CSP;
  if (download) headers['Content-Disposition'] = `attachment; filename="${basename(abs).replace(/[^\w.\- ]/g, '_')}"`;
  res.writeHead(200, headers);
  if (req.method === 'HEAD') return res.end();
  createReadStream(abs).pipe(res);
}

const server = http.createServer(async (req, res) => {
  try {
    if (!ALLOWED_HOSTS.has(req.headers.host)) return json(res, 403, { error: 'Forbidden.' });
    const url = new URL(req.url, 'http://local');
    const p = url.pathname;
    const method = req.method;

    // Anything that changes state must come from this page, as JSON (which forces a CORS preflight
    // for other origins, and we reject their Origin anyway).
    if (method !== 'GET' && method !== 'HEAD') {
      if (!originOk(req)) return json(res, 403, { error: 'Forbidden.' });
      if (method === 'POST' && !/^application\/json/i.test(req.headers['content-type'] || '')) {
        return json(res, 415, { error: 'Expected JSON.' });
      }
    }

    // ---- API ----
    if (p === '/api/settings' && method === 'GET') return json(res, 200, await aiSettings());
    if (p === '/api/settings' && method === 'POST') {
      const b = await readJson(req);
      const T = await import('../lib/thinker.mjs');
      try { T.setAiMethod(b.aiMethod); } catch (e) { return json(res, 400, { error: e.message }); }
      wlog(`SETTINGS AI method -> ${T.aiMethod()}`);
      return json(res, 200, await aiSettings(true));
    }
    if (p === '/api/status' && method === 'GET') {
      const bot = botState();
      return json(res, 200, {
        ai: await aiSettings(),
        demo: DEMO,
        chrome: await chromeUp(),
        canva: await canvaStatusCached(),
        bot,
        running: current ? summary(current) : null,
        queued: queue.length,
      });
    }
    if (p === '/api/events' && method === 'GET') {
      res.writeHead(200, {
        'Content-Type': 'text/event-stream', 'Cache-Control': 'no-store', Connection: 'keep-alive',
        'X-Accel-Buffering': 'no',
      });
      res.write('retry: 3000\n\n');
      sse.add(res);
      const ka = setInterval(() => { try { res.write(': ping\n\n'); } catch {} }, 20_000);
      req.on('close', () => { clearInterval(ka); sse.delete(res); });
      return;
    }
    if (p === '/api/jobs' && method === 'GET') {
      return json(res, 200, {
        jobs: [...jobs.values()].map((j) => ({ ...summary(j), log: j.log.slice(-400) })),
      });
    }
    if (p === '/api/jobs' && method === 'POST') {
      const body = await readJson(req, 48 * 1024 * 1024);
      // The Telegram bot posts here too (origin 'telegram'); the browser form never sets those fields.
      const bj = buildJobs(body);
      if (bj.error) return json(res, 400, { error: bj.error });
      if (queue.length + bj.specs.length > MAX_QUEUED) return json(res, 429, { error: `The queue is full (${MAX_QUEUED}). Let some finish first.` });
      const made = [];
      for (const spec of bj.specs) {
        if (body.origin === 'telegram' && body.chatId) Object.assign(spec, { origin: 'telegram', chatId: String(body.chatId) });
        const r = createJob(spec);
        if (r.error) { if (!made.length) return json(res, r.status, { error: r.error }); break; }
        made.push(summary(r.job));
      }
      return json(res, 202, { job: made[0], jobs: made });
    }
    // Telegram "final" / "retry": act on the newest design this chat asked for.
    if ((p === '/api/telegram/final' || p === '/api/telegram/retry') && method === 'POST') {
      const b = await readJson(req);
      const chatId = String(b.chatId || '');
      const rows = [...tracker.values()].filter((r) => r.origin === 'telegram' && String(r.chatId) === chatId && r.runId).sort((a, c) => c.createdAt - a.createdAt);
      if (!rows.length) return json(res, 404, { error: 'There is no design from this chat yet. Send a reference link first.' });
      const row = rows[0]; const dir = join(DESIGN_DIR, row.runId);
      const tg = await import('../lib/telegram.mjs');
      const dz = await import('../design.mjs');
      try {
        if (p.endsWith('/retry')) {
          await dz.retryCanva(dir, { log: (...a) => wlog(`RETRY ${row.runId} ${a.join(' ')}`) });
          const o = designOutcome(row.runId);
          await tg.sendText(`Re-sent to Canva.${o.canvaUrl ? `\nEdit in Canva: ${o.canvaUrl}` : ''}`, chatId);
        } else {
          const dj = readJsonFile(join(dir, 'design.json'));
          const idx = Number.isInteger(dj?.best) ? dj.best : 0;
          const file = await dz.pullFinal(dir, idx, { log: (...a) => wlog(`FINAL ${row.runId} ${a.join(' ')}`) });
          copyFileSync(file, join(dir, 'FINAL.png'));
          await tg.sendImage(file, `Final from Canva: ${row.description || 'design'}`, chatId, { asFile: true });
          emit('design', { id: row.runId });
        }
      } catch (e) { return json(res, 502, { error: e.message }); }
      return json(res, 200, { ok: true });
    }
    // Your thumbs up / down on a finished design: it feeds Ashadi's prompt playbook (lib/promptbook.mjs).
    const fm = p.match(/^\/api\/jobs\/([0-9a-f-]{36})\/feedback$/);
    if (fm && method === 'POST') {
      const b = await readJson(req);
      const live = jobs.get(fm[1]);
      const rec = live ? trackerRecord(live) : tracker.get(fm[1]);
      if (!rec?.runId) return json(res, 404, { error: 'That design has no finished run to rate yet.' });
      const pb = await import('../lib/promptbook.mjs');
      let n = 0;
      try { n = pb.rate(rec.runId, b.rating, b.note); } catch (e) { return json(res, 400, { error: e.message }); }
      if (!n) return json(res, 404, { error: 'Nothing was recorded for that run, so there is nothing to learn from yet.' });
      if (live) touch(live, { rating: b.rating });
      else { tracker.set(fm[1], { ...rec, rating: b.rating }); clearTimeout(trackerTimer); trackerTimer = setTimeout(saveTracker, 500); emit('job', { ...summaryOf(rec) }); }
      return json(res, 200, { ok: true, rating: b.rating });
    }
    if (p === '/api/tracker' && method === 'GET') {
      const live = new Map([...jobs.values()].map((j) => [j.id, trackerRecord(j)]));
      const rows = [...new Map([...tracker, ...live]).values()].sort((a, b) => b.createdAt - a.createdAt).slice(0, 300)
        .map(({ input, logTail, chatId, ...r }) => r);
      return json(res, 200, { rows });
    }
    // Remove one finished row from the tracker (the design files on disk are NOT touched).
    const tm = p.match(/^\/api\/tracker\/([0-9a-f-]{36})$/);
    if (tm && method === 'DELETE') {
      const id = tm[1];
      const live = jobs.get(id);
      const row = live || tracker.get(id);
      if (!row) return json(res, 404, { error: 'That row is not in the tracker.' });
      if (['queued', 'running', 'waiting'].includes(row.status)) return json(res, 409, { error: 'That job is still active. Stop it first, then remove it.' });
      jobs.delete(id);
      tracker.delete(id);
      clearTimeout(trackerTimer); trackerTimer = setTimeout(saveTracker, 200);
      emit('tracker-removed', { id });
      return json(res, 200, { ok: true });
    }
    // Sithiji → Ashadi: a content card pushed from the Sithiji dashboard. The PC worker
    // (sithiji/worker_pc.py) claims the request on the VPS and posts it here with the card's
    // own pictures as the reference (base64 in JSON — this server only takes JSON).
    if (p === '/api/sithiji/jobs' && method === 'POST') {
      const b = await readJson(req, 48 * 1024 * 1024);
      const cid = clampInt(b.cid, 1, 1e9, 0);
      if (!cid) return json(res, 400, { error: 'Missing the Sithiji card id.' });
      const dir = join(INBOX_DIR, `sithiji-${cid}-${Date.now()}`);
      const refFiles = [];
      for (const [i, f] of (Array.isArray(b.files) ? b.files : []).slice(0, 6).entries()) {
        const ext = extname(String(f?.name || '')).toLowerCase();
        if (!['.jpg', '.jpeg', '.png', '.webp'].includes(ext) || typeof f.b64 !== 'string') continue;
        mkdirSync(dir, { recursive: true });
        const file = join(dir, `ref-${String(i + 1).padStart(2, '0')}${ext}`);
        writeFileSync(file, Buffer.from(f.b64, 'base64'));
        refFiles.push(file);
      }
      const ig = String(b.source_url || '').match(IG_RE);
      if (!refFiles.length && !ig) return json(res, 400, { error: 'The card has no picture and no Instagram link to copy.' });
      const source = refFiles.length ? `Sithiji #${cid}` : `https://www.instagram.com/${ig[1].toLowerCase() === 'reels' ? 'reel' : ig[1].toLowerCase()}/${ig[2]}/`;
      const pu = String(b.product_url || '').trim();
      const r = createJob({
        mode: 'design', kind: 'reference', source, instruction: String(b.instruction || '').slice(0, 500), count: 1,
        refFiles, caption: String(b.caption || '').slice(0, 1500), tag: `sithiji-${cid}`, origin: 'sithiji',
        productUrl: KAPRUKA_URL_RE.test(pu) ? pu : '', description: `Sithiji card #${cid}${b.title ? `: ${short(String(b.title), 60)}` : ''}`,
      });
      if (r.error) return json(res, r.status, { error: r.error });
      return json(res, 202, { job: summary(r.job) });
    }
    let m = p.match(/^\/api\/jobs\/([0-9a-f-]{36})$/);
    if (m && method === 'DELETE') {
      const r = cancelJob(m[1]);
      return r.error ? json(res, r.status, { error: r.error }) : json(res, 200, { job: summary(r.job) });
    }
    if (p === '/api/runs' && method === 'GET') return json(res, 200, { runs: listRuns() });
    m = p.match(/^\/api\/runs\/([^/]+)$/);
    if (m && method === 'GET') {
      const d = runDetail(decodeURIComponent(m[1]));
      return d ? json(res, 200, d) : json(res, 404, { error: 'No such run.' });
    }

    // ---- Canva sign-in (one time; tokens refresh themselves after that) ----
    if (p === '/api/canva' && method === 'GET') return json(res, 200, await canvaStatusCached(true));
    if (p === '/canva/connect' && method === 'GET') {
      if (!canvaConfigured()) return json(res, 400, { error: 'CANVA_CLIENT_ID / CANVA_CLIENT_SECRET are missing from .env.' });
      res.writeHead(302, { Location: authorizeUrl(), 'Cache-Control': 'no-store' });
      return res.end();
    }
    if (p === '/canva/callback' && method === 'GET') {
      const err = url.searchParams.get('error');
      let to = '/?canva=connected';
      // Log every return from Canva (param NAMES only for the success case — never the code).
      wlog(`CANVA callback: ${err ? `error=${err} ${url.searchParams.get('error_description') || ''}` : `params=${[...url.searchParams.keys()].join(',')}`}`);
      if (err) {
        to = `/?canva=error&reason=${encodeURIComponent(url.searchParams.get('error_description') || err)}`;
      } else {
        try {
          await finishAuthorize(url.searchParams.get('code') || '', url.searchParams.get('state') || '');
          canvaCache.at = 0;
          wlog('CANVA connected');
        }
        catch (e) { wlog(`CANVA connect failed: ${e.message}`); to = `/?canva=error&reason=${encodeURIComponent(e.message)}`; }
      }
      res.writeHead(302, { Location: to, 'Cache-Control': 'no-store' });
      return res.end();
    }

    // ---- design runs (Canva) ----
    if (p === '/api/designs' && method === 'GET') return json(res, 200, { designs: listDesigns() });
    m = p.match(/^\/api\/designs\/([^/]+)$/);
    if (m && method === 'GET') {
      const d = designDetail(decodeURIComponent(m[1]));
      return d ? json(res, 200, d) : json(res, 404, { error: 'No such design.' });
    }
    m = p.match(/^\/api\/designs\/([^/]+)\/final$/);
    if (m && method === 'POST') {
      const name = decodeURIComponent(m[1]);
      if (!NAME_RE.test(name) || !existsSync(join(DESIGN_DIR, name, 'design.json'))) return json(res, 404, { error: 'No such design.' });
      const body = await readJson(req);
      const { pullFinal } = await import('../design.mjs');
      try {
        await pullFinal(join(DESIGN_DIR, name), clampInt(body.variant, 0, 20, 0), { log: (...a) => wlog(`FINAL ${name} ${a.join(' ')}`) });
      } catch (e) {
        return json(res, 502, { error: `Couldn't pull the final from Canva: ${e.message}` });
      }
      emit('design', { id: name });
      return json(res, 200, designDetail(name));
    }
    m = p.match(/^\/api\/designs\/([^/]+)\/retry-canva$/);
    if (m && method === 'POST') {
      const name = decodeURIComponent(m[1]);
      if (!NAME_RE.test(name) || !existsSync(join(DESIGN_DIR, name, 'design.json'))) return json(res, 404, { error: 'No such design.' });
      const { retryCanva } = await import('../design.mjs');
      try {
        await retryCanva(join(DESIGN_DIR, name), { log: (...a) => wlog(`RETRY ${name} ${a.join(' ')}`) });
      } catch (e) {
        return json(res, 502, { error: `Still couldn't send it to Canva: ${e.message}` });
      }
      emit('design', { id: name });
      return json(res, 200, designDetail(name));
    }
    if (p.startsWith('/dfiles/') && (method === 'GET' || method === 'HEAD')) {
      let rel;
      try { rel = decodeURIComponent(p.slice('/dfiles/'.length)); } catch { return json(res, 400, { error: 'Bad path.' }); }
      const abs = resolve(DESIGN_DIR, rel);
      if (!abs.startsWith(DESIGN_DIR + sep) || !FILE_EXTS.has(extname(abs).toLowerCase())) return json(res, 404, { error: 'Not found.' });
      return serveFile(req, res, abs, { download: url.searchParams.has('download'), cacheable: url.searchParams.has('v') });
    }

    // ---- files from past runs ----
    if (p.startsWith('/files/') && (method === 'GET' || method === 'HEAD')) {
      let rel;
      try { rel = decodeURIComponent(p.slice('/files/'.length)); } catch { return json(res, 400, { error: 'Bad path.' }); }
      const abs = resolve(REC_DIR, rel);
      if (!abs.startsWith(REC_DIR + sep) || !FILE_EXTS.has(extname(abs).toLowerCase())) {
        return json(res, 404, { error: 'Not found.' });
      }
      return serveFile(req, res, abs, { download: url.searchParams.has('download'), cacheable: url.searchParams.has('v') });
    }

    // ---- the page itself ----
    if (method === 'GET' || method === 'HEAD') {
      const name = p === '/' ? 'index.html' : p.slice(1);
      if (STATIC.has(name)) return serveFile(req, res, join(PUBLIC_DIR, name));
    }
    return json(res, 404, { error: 'Not found.' });
  } catch (e) {
    if (!res.headersSent) json(res, e.status || 500, { error: e.status ? e.message : 'Server error.' });
    if (!e.status) wlog(`ERR ${req.method} ${req.url}: ${e.stack || e.message}`);
  }
});

/** Reload the tracker after a restart: finished rows come back as history; jobs that were waiting or mid-run are queued again (once). */
function restoreTracker() {
  let saved;
  try { saved = JSON.parse(readFileSync(TRACKER_FILE, 'utf8')); } catch { return; }
  let requeued = 0;
  for (const r of saved.rows || []) {
    const finished = ['done', 'failed', 'cancelled', 'stopped', 'interrupted'].includes(r.status);
    if (finished) { tracker.set(r.id, { ...r, position: null }); continue; }
    const input = r.input;
    const can = input && (r.attempts || 0) < 5 && !(input.ref?.type === 'file' && !existsSync(input.ref.value));
    if (!can) { tracker.set(r.id, { ...r, status: 'interrupted', message: 'Interrupted by a restart', position: null }); continue; }
    const job = {
      id: r.id, ...input, origin: r.origin, description: r.description, canvaUrl: null, finalUrl: null, chatId: r.chatId,
      status: 'queued', message: 'Resumed after a restart — waiting in the queue…', step: 0, attempts: r.attempts || 0,
      createdAt: r.createdAt, startedAt: null, finishedAt: null, runId: null, imageCount: null, error: null, log: [],
    };
    jobs.set(job.id, job); queue.push(job); job.input = jobInput(job); track(job); requeued++;
  }
  if (requeued) { wlog(`TRACKER restored: ${requeued} job(s) put back in the queue`); setTimeout(pump, 2000); }
}
restoreTracker();

server.on('error', (e) => {
  console.error(e.code === 'EADDRINUSE'
    ? `Port ${PORT} is already in use — is the web UI already running? (set IG2IMG_WEB_PORT to use another)`
    : e.message);
  process.exit(1);
});
server.listen(PORT, HOST, () => {
  const msg = `ig2img web UI on http://${HOST}:${PORT}${DEMO ? '  [DEMO MODE — simulated runs]' : ''}`;
  console.log(msg);
  wlog(msg);
});
